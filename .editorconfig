root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{c,h}]
indent_size = 2
max_line_length = 80

[*.java]
indent_size = 2
max_line_length = 100

[*.sh]
indent_size = 2

[*.{c,h,java,sh,kts}]
max_line_length = 100

[*.json]
indent_size = 2

[*.py]
max_line_length = 80

[*.md]
trim_trailing_whitespace = false

[*.bat]
end_of_line = crlf
